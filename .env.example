# Supabase Configuration
# Required for connecting to your Supabase project (PostgreSQL + Auth + RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-SIDE ONLY)
# CRITICAL: Never expose this key to client-side code or browser bundles.
# Used exclusively by server-side APIs for webhook fulfillment and administrative operations.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack Configuration
# Paystack Secret Key (SERVER-SIDE ONLY - used for initiating transactions and verifying webhooks)
PAYSTACK_SECRET_KEY=
# Paystack Public Key (optional client reference)
PAYSTACK_PUBLIC_KEY=
# Paystack Webhook Secret (if configured separately; defaults to PAYSTACK_SECRET_KEY)
PAYSTACK_WEBHOOK_SECRET=

# Base URL of the application (used for Paystack checkout redirect callback)
# Example: https://ais-dev-cagysd2yihbkcfe6kw3xa4-701377274469.europe-west2.run.app
APP_URL=
